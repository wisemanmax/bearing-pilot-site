{
  "name": "sakura-crossing-ios",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An explorable Japanese suburban railway-crossing street rendered 3D-to-2D in a cel-shaded anime style, ported to iOS.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "play": "vite build && vite preview --port 5179 --open",
    "icons": "node tools/make-icons.mjs",
    "smoke": "node tools/smoke.mjs",
    "ios:init": "cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "playwright": "^1.62.0",
    "vite": "^6.0.0"
  }
}
